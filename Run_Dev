@echo off
echo ============================================
echo   AI File Assistant  ^|  DEV MODE
echo ============================================
echo.

cd /d "%~dp0"

REM Hand everything to PowerShell — timestamp, logging, and launch.
REM  PYTHONWARNINGS=default   -- re-enables warnings suppressed in production
REM  PYTHONUTF8=1             -- consistent encoding
REM  PYTHONFAULTHANDLER=1     -- traceback even on hard crashes / segfaults
REM  python -u                -- unbuffered so nothing is held back before a crash

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "if (-not (Test-Path 'logs')) { New-Item -ItemType Directory -Path 'logs' | Out-Null };" ^
    "$log = 'logs\dev_' + (Get-Date -Format 'yyyyMMdd_HHmmss') + '.log';" ^
    "Write-Host ('[DEV] Log file : ' + $log);" ^
    "Write-Host '[DEV] Mode     : Full warnings + unbuffered + fault handler';" ^
    "Write-Host '';" ^
    "Write-Host '============================================';" ^
    "Write-Host '';" ^
    "$env:PYTHONWARNINGS='default';" ^
    "$env:PYTHONUTF8='1';" ^
    "$env:PYTHONFAULTHANDLER='1';" ^
    "cmd /c 'python -u assistant.py 2>&1' | Tee-Object -FilePath $log;" ^
    "$code = $LASTEXITCODE;" ^
    "Write-Host '';" ^
    "Write-Host '============================================';" ^
    "Write-Host ('  Process ended - exit code: ' + $code);" ^
    "Write-Host ('  Log saved to : ' + $log);" ^
    "Write-Host '============================================'"

echo.
pause
